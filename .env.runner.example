# GitHub Personal Access Token (Optional - can be configured via script menu)
# Create at: https://github.com/settings/tokens/new
# Required permissions: repo, workflow
#
# You can set this environment variable OR configure via script menu (Option 1)
# The script supports multiple storage methods:
#   1. Windows Environment Variable (User-level, persistent)
#   2. Configuration File (Local, base64 encoded)
#   3. Session Only (Not saved, re-enter each time)
#
# To set manually:
# PowerShell: $env:GITHUB_TOKEN = "ghp_your_token_here"
# Or: [System.Environment]::SetEnvironmentVariable("GITHUB_RUNNER_TOKEN", "ghp_your_token_here", "User")

GITHUB_TOKEN=ghp_your_token_here
